# Google Cloud project id (Cloud Run / Firestore / Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to a Google Cloud service account key file (local dev only).
# On Cloud Run, use the runtime service account instead — never ship key files.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-key.json

# Gemini model served via Vertex AI (google-genai SDK)
GEMINI_MODEL=gemini-3.5-flash

# Google Places API (New) key — Places Text Search
GOOGLE_PLACES_API_KEY=your-places-api-key

# --- Optional: dual-score ranking weights (Feature: Honest Dual-Score Ranking) ---
INTENT_WEIGHT=0.45
TASTE_WEIGHT=0.55

# --- Optional: feedback memory loop tuning (Feature: Feedback Memory Loop) ---
# Max feedback entries aggregated into the agent prompt
FEEDBACK_SUMMARY_LIMIT=25
# Bidirectional weight mutation steps
FEEDBACK_LIKE_STEP=0.02
FEEDBACK_DISLIKE_STEP=0.04
FEEDBACK_TOURISTY_STEP=0.08
# Learned-taste weights are clamped to [0.2, 1.0]
WEIGHT_FLOOR=0.2
WEIGHT_CEILING=1.0
